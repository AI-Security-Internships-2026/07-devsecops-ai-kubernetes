# LLM for per-CVE risk explanations and the chat assistant.
#
# Providers are tried in this order: local -> Groq -> Gemini. A configured local
# endpoint therefore wins over any cloud key left in the environment, so the
# private path is the default path. Set LLM_PROVIDER to pin one explicitly.

# Option 1 (preferred): a SELF-HOSTED model behind an OpenAI-compatible endpoint.
# Works with Ollama, vLLM, SGLang or a LiteLLM gateway 

# LOCAL_LLM_BASE_URL=http://localhost:11434/v1      # Ollama's OpenAI-compatible API
# LOCAL_LLM_MODEL=qwen2.5-coder:32b                 # must be a tool-calling model for `chat`
# LOCAL_LLM_API_KEY=not-needed                      # placeholder; local servers ignore it

# Option 2: Groq (free tier, fast)
# Get a key from: https://console.groq.com/keys
# GROQ_API_KEY=YOUR_GROQ_API_KEY

# Option 3: Google Gemini
# Get a key from: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY

# Pin one backend instead of taking the first configured one. Required for a
# reproducible local-vs-cloud comparison, since it removes the "whichever key
# happened to be set" variable.
# LLM_PROVIDER=local        # local | groq | gemini | none

# Model override for the CLOUD providers only (local uses LOCAL_LLM_MODEL).
# Defaults: llama-3.1-8b-instant (Groq), gemini-2.5-flash (Gemini).
# LLM_MODEL=gemini-2.5-flash

# Parallel explanation requests (default 6). The calls are independent, so they run
# concurrently; the cap exists because the GPU may be shared — too many in-flight
# requests degrade everyone's throughput instead of improving yours.
# LLM_CONCURRENCY=6
