# Google Gemini API key for LLM-powered triage summaries (optional)
# Get your key from: https://aistudio.google.com/apikey
# The triage agent works without this — it just skips the LLM executive summary
GOOGLE_API_KEY=your-google-api-key-here

# LLM model to use (default: gemini-2.5-pro-preview-05-06)
LLM_MODEL=gemini-2.5-pro-preview-05-06
