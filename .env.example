# LLM for per-CVE risk explanations (set ONE of these — Groq checked first)

# Option 1: Groq (FREE, fast — recommended, uses Llama-3.1)
# Get key from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Option 2: Google Gemini (fallback if no Groq key)
# Get key from: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your-google-api-key-here

# LLM model override (defaults: llama-3.1-8b-instant for Groq, gemini-2.5-pro-preview-05-06 for Google)
# LLM_MODEL=llama-3.1-8b-instant
